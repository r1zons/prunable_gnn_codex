#!/bin/bash
set -euo pipefail
started=$(date +%s)
export LC_ALL=C LANG=C
: "${LSB_JOBID:?Submit through LSF}"
sha256sum --quiet -c launch.sha256
cmp expected-data.md5 data/VERIFIED.md5
activation="$HOME/gnn-p100-20261110/activate-p100.sh"
printf '%s  %s\n' "$(cat activation.sha256)" "$activation" | sha256sum -c -
source "$activation"
export PYTHONPATH="$PWD/src"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
hostname
nvidia-smi --query-gpu=name,driver_version,pci.bus_id,memory.total --format=csv
exec taskset -c 0,8,16,24 python -u -m gnn_pruning.experiments.meshgraphnet_training \
  --config configs/experiments/meshgraphnet_cylinderflow_training.yaml \
  --data data --output "run.$LSB_JOBID" --job-start "$started"
